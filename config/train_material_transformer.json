{
  "architecture": "VisionMaterial-Transformer",
  "image_size": 160,
  "width": 96,
  "depth": 4,
  "heads": 4,
  "dropout": 0.12,
  "preprocessing": "letterbox-v2",
  "normalization": {"mean": [0.5, 0.5, 0.5], "std": [0.5, 0.5, 0.5]},
  "initialization": "random_from_scratch",
  "test_used": false,
  "seed": 89,
  "epochs": 42,
  "batch_size": 128,
  "workers": 8,
  "epoch_samples": 8192,
  "learning_rate": 0.0012,
  "weight_decay": 0.003,
  "warmup_epochs": 3,
  "ema_decay": 0.982,
  "minimum_original_macro_F1": 0.74,
  "scene_fraction": 0.32,
  "swim3_fraction": 0.12,
  "extra_fraction": 0.25,
  "sampling_focus": {"papel": 1.12, "carton": 1.18, "organicos": 1.16},
  "detected_view_weight": 0.8,
  "augmentation": {"rotation_degrees": 14, "brightness": 0.24, "contrast": 0.18, "color": 0.15, "min_scale": 0.84}
}
